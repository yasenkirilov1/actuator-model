/acf_simulink/validation/**/sdi/
/acf_simulink/validation/**/slprj/
/slprj/
/acf_simulink/generated/*.zip

# Rebuildable report bundles; source reports and figures remain visible.
/reports/prototype-design-20260930/dist/
/reports/prototype-design-20260930/.data-app-offline/
__pycache__/
*.pyc

# Local MATLAB preferences can contain licensing credentials.
/acf_simulink/validation/**/*prefs*/
/acf_simulink/validation/**/*preferences*/
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example

# Rebuildable native binaries, simulation build trees and installers.
*.so
*.o
*.a
*.mex*
*.slxc
*.dmr
*.asv
*_rtw/
/acf_simulink/validation/**/code/
/acf_simulink/validation/rl_native_probe_20261005_install/mpm
node_modules/
/.playwright-cli/

